{
  "expo": {
    "name": "Skwik",
    "slug": "skwik",
    "scheme": "skwik",
    "version": "1.6.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF9F5",
    "primaryColor": "#0B7A6B",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.skwik.billing",
      "versionCode": 11,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#FAF9F5"
      }
    },
    "ios": {
      "bundleIdentifier": "com.skwik.billing",
      "supportsTablet": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FAF9F5"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FAF9F5",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#FAF9F5"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Skwik uses the camera only to read barcodes while you bill."
        }
      ]
    ]
  }
}
